{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ice-chart-dsl document",
  "description": "JSON-first DSL for building ice-chart charts: a table plus an encoding that binds columns to visual channels.",
  "type": "object",
  "required": ["kind"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": {
      "enum": [
        "line",
        "area",
        "bar",
        "pie",
        "scatter",
        "function",
        "radar",
        "heatmap",
        "sankey",
        "treemap",
        "gauge",
        "boxplot",
        "waterfall",
        "funnel",
        "graph",
        "parametric",
        "liquid",
        "violin",
        "beeswarm",
        "hexbin",
        "calendar",
        "alluvial"
      ]
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "required": ["columns", "rows"],
          "properties": {
            "columns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "rows": { "type": "array", "items": { "type": "array" } }
          }
        },
        {
          "type": "array",
          "description": "对象数组写法：[{ 月份: '1月', 销量: 120 }]",
          "items": { "type": "object" }
        }
      ]
    },
    "encoding": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "x": { "type": "string", "description": "横轴列（数值列自动用数值轴）" },
        "y": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "series": { "type": "string", "description": "分组列：同一 x 上拆成多个系列" },
        "size": { "type": "string", "description": "第三维：气泡大小" },
        "color": { "type": "string" },
        "name": { "type": "string", "description": "名称列（饼图/漏斗等）" },
        "value": { "type": "string", "description": "数值列（饼图/漏斗/仪表盘/热力图/桑基等）" },
        "total": { "type": "string", "description": "瀑布图：非 0 的行当合计项" },
        "source": { "type": "string", "description": "桑基图：连线起点列" },
        "target": { "type": "string", "description": "桑基图：连线终点列" },
        "axes": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "description": "多轴分类流：按顺序列出每个轴的列名（至少两个）"
        }
      }
    },
    "matrix": {
      "type": "object",
      "required": ["rows", "columns"],
      "description": "面板矩阵（数据驱动分面）：把 encoding.series 拆出来的每个分组放进一块面板",
      "properties": {
        "rows": { "oneOf": [{ "type": "number" }, { "type": "array", "items": { "type": "number" } }] },
        "columns": { "oneOf": [{ "type": "number" }, { "type": "array", "items": { "type": "number" } }] },
        "gap": { "type": "number", "description": "面板间距（设备像素）" }
      }
    },
    "calendar": {
      "type": "object",
      "description": "日历热力的排布与配色（列名走 encoding.x / encoding.y）",
      "properties": {
        "weekStart": { "enum": [0, 1], "description": "0 = 周日，1 = 周一（默认）" },
        "weekdayLabels": { "type": "boolean", "description": "是否画左侧星期标签，默认 true" },
        "monthLabels": { "type": "boolean", "description": "是否画顶部月份标签，默认 true" },
        "minColor": { "type": "string", "description": "稀（低值）一端的颜色" },
        "maxColor": { "type": "string", "description": "密（高值）一端的颜色" }
      }
    },
    "alluvial": {
      "type": "object",
      "description": "多轴分类流的排序与观感（轴列名走 encoding.axes，流量列走 encoding.value）",
      "properties": {
        "spread": { "type": "number", "description": "轴心之间的总跨度占绘图区宽度的比例，默认 0.62" },
        "nodeWidth": { "type": "number", "description": "节点条宽度（像素），默认 12" },
        "gap": { "type": "number", "description": "节点之间的垂直间隙（像素），默认 6" },
        "sort": { "enum": ["total", "name"], "description": "节点排序：按流量（默认）或按名字" },
        "ribbonOpacity": { "type": "number", "description": "连线的不透明度，默认 0.35" }
      }
    },
    "title": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "properties": { "text": { "type": "string" }, "subtext": { "type": "string" } }
        }
      ]
    },
    "annotation": {
      "description": "标注图层（目标线 / 阈值线 / 异常点 / 目标区间）。值都用数据值，不是像素；只对直角坐标的 kind 有效。",
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value"],
            "properties": {
              "axis": { "enum": ["x", "y"], "description": "y（默认）画水平线，x 画垂直线" },
              "value": { "oneOf": [{ "type": "number" }, { "type": "string" }], "description": "数据值：数值轴写数字，类目轴写类目名或下标" },
              "text": { "type": "string" },
              "color": { "type": "string" },
              "dashed": { "type": "boolean", "description": "默认 true" },
              "textPosition": { "enum": ["start", "center", "end"] }
            }
          }
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
              "y": { "type": "number" },
              "text": { "type": "string" },
              "color": { "type": "string" },
              "symbol": { "enum": ["circle", "rect", "diamond", "triangle"] },
              "textPosition": { "enum": ["top", "bottom", "left", "right"] }
            }
          }
        },
        "areas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "axis": { "enum": ["x", "y"], "description": "y（默认）是横向的带，x 是纵向的带" },
              "from": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
              "to": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
              "color": { "type": "string" },
              "text": { "type": "string" },
              "textPosition": { "enum": ["start", "center", "end"] }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "expression": { "type": "string", "description": "kind 为 function / parametric 时的公式" },
    "domain": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "params": { "type": "object", "additionalProperties": { "type": "number" } },
    "options": { "type": "object", "description": "逃生舱：直接并进 ChartOption（同名键覆盖编译结果）" },
    "series": { "type": "array", "description": "逃生舱：直接给 option.series（给了它就不再走 data/encoding）" }
  },
  "additionalProperties": true
}
